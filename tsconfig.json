{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.js",
    "lib/ip-list/**/*.js",
    "lib/ip-list/test/typecheck.ts",
    "src/**/*.ts",
    "test/typecheck.ts",
    "lib/dns-wasm/test/typecheck.ts",
    "lib/ech-probe/test/typecheck.ts",
    "test/worker.js",
    "test/doh-options-worker.js",
    "test/online-fixture-worker.js"
  ]
}
