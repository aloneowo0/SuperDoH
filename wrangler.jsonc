{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superdoh",
  "main": "src/worker.js",
  "build": { "command": "node scripts/build-ip-lists.mjs" },
  // Runtime JSON variables are managed in the Dashboard; do not erase them on code deploy.
  "keep_vars": true,
  // Keep the public entry aligned with the pinned workerd behavior tests.
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["enable_request_signal", "global_fetch_strictly_public", "no_nodejs_compat", "no_nodejs_compat_v2"],
  // Preserve readable function locations for future production CPU profiles.
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
  // DNS_RULE_*, DNS_LIMITS and DNS_UPSTREAMS are deployment environment bindings.
  // DNS_PATH_KEY is an optional Secret; never put its value in this file.
}
