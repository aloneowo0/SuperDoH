{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-doh-rs",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-08-01",
  "build": {
    "command": "cargo install -q worker-build@^0.8 && worker-build --release --no-panic-recovery"
  },
  "observability": {
    "enabled": true
  }
}
