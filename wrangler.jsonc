{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superdoh",
  "main": "src/worker.js",
  // Keep the public entry aligned with the pinned workerd behavior tests.
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["enable_request_signal"],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
  // DNS_RULE_*, DNS_LIMITS and DNS_UPSTREAM are deployment environment bindings.
  // DNS_PATH_KEY is an optional Secret; never put its value in this file.
}
